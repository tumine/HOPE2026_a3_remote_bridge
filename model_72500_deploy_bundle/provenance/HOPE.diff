+def apply_torso_wrench_impulse_curriculum(
+    env: ManagerBasedEnv,
+    env_ids: torch.Tensor,
+    force_range: dict[str, tuple[float, float]],
+    torque_range: dict[str, tuple[float, float]],
+    curriculum_start_step: int,
+    curriculum_duration_steps: int,
+    curriculum_initial_fraction: float = 0.0,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+):
+    """Apply a one-physics-step world-frame wrench impulse to selected torso bodies.
+
+    Isaac Lab clears the instantaneous wrench composer after every physics step,
+    so this event is a genuine shove rather than a force that silently persists
+    until the next interval or episode reset.  The configured values are force
+    and torque amplitudes; their impulses are those amplitudes multiplied by the
+    simulation time step.
+    """
+
+    asset: Articulation = env.scene[asset_cfg.name]
+    if env_ids is None:
+        env_ids = torch.arange(env.scene.num_envs, device=asset.device)
+
+    progress = linear_curriculum_progress(
+        getattr(env, "common_step_counter", 0),
+        int(curriculum_start_step),
+        int(curriculum_duration_steps),
+    )
+    scale = curriculum_fraction(float(curriculum_initial_fraction), progress)
+    scaled_force = curriculum_scaled_range(force_range, scale)
+    scaled_torque = curriculum_scaled_range(torque_range, scale)
+
+    num_bodies = (
+        len(asset_cfg.body_ids)
+        if isinstance(asset_cfg.body_ids, list)
+        else asset.num_bodies
+    )
+    shape = (len(env_ids), num_bodies, 3)
+    force_limits = torch.tensor(
+        [scaled_force.get(axis, (0.0, 0.0)) for axis in ("x", "y", "z")],
+        dtype=torch.float,
+        device=asset.device,
+    )
+    torque_limits = torch.tensor(
+        [scaled_torque.get(axis, (0.0, 0.0)) for axis in ("roll", "pitch", "yaw")],
+        dtype=torch.float,
+        device=asset.device,
+    )
+    forces = math_utils.sample_uniform(
+        force_limits[:, 0], force_limits[:, 1], shape, device=asset.device
+    )
+    torques = math_utils.sample_uniform(
+        torque_limits[:, 0], torque_limits[:, 1], shape, device=asset.device
+    )
+    asset.instantaneous_wrench_composer.set_forces_and_torques(
+        forces=forces,
+        torques=torques,
+        body_ids=asset_cfg.body_ids,
+        env_ids=env_ids,
+        is_global=True,
+    )
+
+    env._hope_torso_push_curriculum_progress = float(progress)
+    env._hope_torso_push_curriculum_scale = float(scale)
+
