+def forehand_ready_action_target_l2(
+    env: ManagerBasedRLEnv,
+    command_name: str,
+    action_name: str,
+    joint_names: list[str],
+) -> torch.Tensor:
+    """Penalize READY position targets that depart from the reference joints.
+
+    Pose tracking alone sees measured joint positions, so a position-controlled
+    policy can hide a large steady PD torque behind a near-correct measured pose.
+    This term compares decoded/clamped ``q_des`` against the dedicated READY
+    reference for selected joints. It is intentionally READY-gated and normally
+    used only for the waist, where extreme compensation targets are unsafe when
+    deployment gains differ from training.
+    """
+
+    if not joint_names:
+        raise ValueError("READY action-target joint_names must not be empty")
+    motion = env.command_manager.get_term(command_name)
+    action = env.action_manager.get_term(action_name)
+    action_order = list(getattr(action, "_joint_names", ()))
+    reference_order = list(getattr(motion.cfg, "joint_names", ()))
+    missing_action = [name for name in joint_names if name not in action_order]
+    missing_reference = [name for name in joint_names if name not in reference_order]
+    if missing_action or missing_reference:
+        raise ValueError(
+            "READY action-target joints must exist in both action and reference orders; "
+            f"missing_action={missing_action}, missing_reference={missing_reference}"
+        )
+    action_columns = [action_order.index(name) for name in joint_names]
+    reference_columns = [reference_order.index(name) for name in joint_names]
+    error = torch.mean(
+        torch.square(
+            action.processed_actions[:, action_columns]
+            - motion.joint_pos[:, reference_columns]
+        ),
+        dim=-1,
+    )
+    return error * motion.forehand_ready_pose.float()
+
+
