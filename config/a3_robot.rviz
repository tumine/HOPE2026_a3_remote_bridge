Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 1247
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 125; 125; 125
      Enabled: false
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Mocap world grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: world
      Value: false
    - Alpha: 0.4
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 105; 105; 105
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Physical ground (tabletop - 0.76 m)
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: hope_ground
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.5
      Name: Mocap world origin
      Radius: 0.02
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.35
      Name: HOPE table origin
      Radius: 0.015
      Reference Frame: hope_table
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.25
      Name: Mocap + A3 TF tree
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: PPMocap table ball and marker
      Namespaces:
        ball: true
        net: true
        robot: true
        robot_label: true
        table: true
        table_border: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ppmocap/markers
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 50; 255; 20
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.02
      Length: 0.03
      Line Style: Lines
      Line Width: 0.025
      Name: Ball path (0.5 s)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.01
      Shaft Diameter: 0.01
      Shaft Length: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ppmocap/ball/path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 30; 255
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.02
      Length: 0.03
      Line Style: Lines
      Line Width: 0.035
      Name: Predicted ball path (0.4 s)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 30; 255
      Pose Style: None
      Radius: 0.01
      Shaft Diameter: 0.01
      Shaft Length: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ppmocap/prediction/path
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: Live A3 URDF + right-hand racket
      TF Prefix: a3
      Update Interval: 0
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: PPMocap camera
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ppmocap/camera/image_raw/compressed
      Value: false
  Enabled: true
  Global Options:
    Background Color: 119; 118; 123
    Fixed Frame: world
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.464756488800049
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 1.5104554891586304
        Y: -0.5506091713905334
        Z: 0.030563030391931534
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: PPMocap + A3 scene
      Near Clip Distance: 0.01
      Pitch: 0.7300007343292236
      Target Frame: world
      Value: Orbit (rviz_default_plugins)
      Yaw: 5.813190937042236
    Saved: ~
Window Geometry:
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Height: 1200
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Views:
    collapsed: false
  Width: 2000
  X: 70
  Y: 27
