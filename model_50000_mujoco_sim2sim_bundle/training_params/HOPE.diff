+def curriculum_actuator_stiffness(
+    env: ManagerBasedEnv,
+    env_ids: torch.Tensor | None,
+    asset_cfg: SceneEntityCfg,
+    joint_names: tuple[str, ...] | list[str],
+    start_stiffness_by_joint: dict[str, float],
+    target_stiffness: float,
+    curriculum_start_step: int,
+    curriculum_duration_steps: int,
+):
+    """Linearly ramp selected implicit-actuator KP values and write them to PhysX.
+
+    The reset event prevents the existing randomized-gain event from leaving a
+    subset of environments at stale waist gains. The interval event then keeps
+    the actuator model and PhysX drive synchronized throughout the ramp.
+    """
+
+    asset: Articulation = env.scene[asset_cfg.name]
+    if env_ids is None:
+        env_ids = torch.arange(env.scene.num_envs, device=asset.device)
+    if env_ids.numel() == 0:
+        return
+
+    _, resolved_names = asset.find_joints(joint_names, preserve_order=True)
+    if set(resolved_names) != set(joint_names):
+        missing = sorted(set(joint_names) - set(resolved_names))
+        raise ValueError(f"waist stiffness curriculum joints not found: {missing}")
+    missing_start = sorted(set(joint_names) - set(start_stiffness_by_joint))
+    if missing_start:
+        raise ValueError(f"missing start stiffness for joints: {missing_start}")
+
+    progress = linear_curriculum_progress(
+        getattr(env, "common_step_counter", 0),
+        int(curriculum_start_step),
+        int(curriculum_duration_steps),
+    )
+    target_stiffness = float(target_stiffness)
+    desired_by_name = {
+        name: float(start_stiffness_by_joint[name])
+        + (target_stiffness - float(start_stiffness_by_joint[name])) * progress
+        for name in joint_names
+    }
+    target_joint_ids, target_joint_names = asset.find_joints(joint_names, preserve_order=True)
+    target_by_global_id = {
+        int(joint_id): desired_by_name[name]
+        for joint_id, name in zip(target_joint_ids, target_joint_names)
+    }
+    target_ids = torch.tensor(target_joint_ids, dtype=torch.long, device=asset.device)
+
+    for actuator in asset.actuators.values():
+        if isinstance(actuator.joint_indices, slice):
+            actuator_global_ids = torch.arange(asset.num_joints, device=asset.device)
+        else:
+            actuator_global_ids = actuator.joint_indices.to(asset.device)
+        local_ids = torch.nonzero(torch.isin(actuator_global_ids, target_ids)).flatten()
+        if local_ids.numel() == 0:
+            continue
+
+        stiffness = actuator.stiffness[env_ids].clone()
+        for local_id, global_id in zip(local_ids.tolist(), actuator_global_ids[local_ids].tolist()):
+            stiffness[:, local_id] = target_by_global_id[int(global_id)]
+        actuator.stiffness[env_ids] = stiffness
+        asset.write_joint_stiffness_to_sim(
+            stiffness,
+            joint_ids=actuator.joint_indices,
+            env_ids=env_ids,
+        )
+
+
