+def _quat_local_z_world(quat_wxyz: np.ndarray) -> np.ndarray:
+    """Return each quaternion's local +Z axis expressed in world coordinates."""
+    w, x, y, z = np.moveaxis(quat_wxyz, -1, 0)
+    return np.stack(
+        (
+            2.0 * (x * z + w * y),
+            2.0 * (y * z - w * x),
+            1.0 - 2.0 * (x * x + y * y),
+        ),
+        axis=-1,
+    )
 
 
