+    quat = _selected_bodies(asset.data.body_link_quat_w, asset_cfg.body_ids)
+    _require_body_count(quat, None, "body_pitch_l2")
+    local_forward = torch.zeros_like(quat[..., :3])
+    local_forward[..., 0] = 1.0
+    forward_w = _quat_apply_wxyz(quat, local_forward)
+    return torch.mean(torch.square(forward_w[..., 2]), dim=-1)
+
